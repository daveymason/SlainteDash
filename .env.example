# =============================================================================
# SLAINTE-ENGINE APPLIANCE: UNIFIED ENVIRONMENT CONFIGURATION
# =============================================================================
# This file defines runtime parameters for all appliance containers:
#   1. slainte-dashboard (Clinical Workstation & FHIR Interface on :8000)
#   2. slainte-fhir      (Micro-EHR & FHIR R4 REST API on :8082)
#   3. slainte-mcp       (FastMCP Deterministic Clinical Scoring Server on :8081)
#   4. slainte-openhands (Autonomous Medical Document Ingestion Loop on :3000)
#   5. slainte-auditor   (Continuous Adversarial BOLA / NIS2 Penetration Agent)
#   6. slainte-ingress   (Caddy Reverse Proxy & Automatic TLS on :80 / :443)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLIANCE SECURITY & CREDENTIALS
# -----------------------------------------------------------------------------
# Cryptographic secret for session signing & CSRF protection (32-byte hex).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=slainte-engine-production-key-99021

# Bootstrap clinical administrator account created on initial launch.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ClinicalAdmin2026!

# Cryptographic salt for pseudonymising patient IDs & audit logs (HMAC-SHA256).
LOG_HASH_SALT=slainte-secure-audit-salt-2026-prod

# Session hardening: set to true when served over HTTPS / TLS reverse proxy.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=60

# -----------------------------------------------------------------------------
# 2. FHIR R4 BACKEND & STORAGE PATHS
# -----------------------------------------------------------------------------
# Appliance internal storage paths mapped to host docker volumes:
RAW_DATA_PATH=/workspace/data/raw
FHIR_STORE_PATH=/workspace/data/fhir_store
REPORT_OUTPUT_DIR=/workspace/data/audit_reports
APPLIANCE_MODE=true

# Active FHIR R4 server endpoints (Internal Docker network routing):
TARGET_FHIR_URL=http://slainte-fhir:8082
FHIR_SERVER_URL=http://slainte-fhir:8082/fhir/r4
HEALTH_SHOW_BACKEND=true

# -----------------------------------------------------------------------------
# 3. AI ENGINE & SOVEREIGN MODEL ROUTING
# -----------------------------------------------------------------------------
# CHOOSE YOUR AI ROUTING MODE:
#
# MODE A: LOCAL SOVEREIGN OLLAMA (DEFAULT — 100% AIR-GAPPED & ON-PREMISE)
# Recommended for NHS / HSE hospitals, zero-trust clinics, and air-gapped deployments.
# Runs locally on host port 11434 via the internal container bridge (no API key needed).
AI_MODEL=ollama/k9/lime:latest
OLLAMA_API_BASE=http://172.19.0.1:11435

# Available local sovereign models pulled on host:
# AI_MODEL=ollama/k9/lime:latest       # Granite 3.7B instruction-tuned medical agent
# AI_MODEL=ollama/k9/lime-lite:latest  # Lightweight Granite 3.7B
# AI_MODEL=ollama/k9/Doggo:3b          # Granite 3.4B clinical scribe
# AI_MODEL=ollama/k9/chihuahua:latest  # LLaMA-3.2 1.2B compact edge agent
# AI_MODEL=ollama/recordstore:latest   # Specialized FHIR entity record extraction
# AI_MODEL=ollama/gemma3:1b            # Gemma-3 1B fast bedside summarizer

# MODE B: CLOUD FRONTIER MODEL (OPENAI GPT-6.1)
# To use cloud models, uncomment the lines below and supply your API key:
# AI_MODEL=openai/gpt-6.1-luna
# OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere
# AI_REASONING_EFFORT=low              # none | low | medium | high | max

# Optional Google Gemini key for SlainteScan FastMCP document OCR engine:
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# -----------------------------------------------------------------------------
# 4. STATUTORY CLINICAL SAFETY & PHI DATA GATES
# -----------------------------------------------------------------------------
# EU GDPR Art. 9 / US HIPAA PHI Gate:
# Patient data is ONLY sent to external cloud LLM providers when pointing to a
# synthetic test server (e.g. hapi.fhir.org, slainte-fhir), UNLESS explicitly
# permitted below with an executed Business Associate Agreement (BAA) / DPIA.
AI_ALLOW_REAL_PHI=false

# Automatic direct PII pseudonymisation (strips name, DOB, telecom, MRN before prompt).
AI_DEIDENTIFY=auto
AI_REQUEST_TIMEOUT=60

# -----------------------------------------------------------------------------
# 5. ENTERPRISE OIDC SSO & CISO SIEM WEBHOOKS (NIS2 ART. 23)
# -----------------------------------------------------------------------------
# Hospital Identity Provider (Microsoft Entra ID, HSE Healthlink, Okta):
# OIDC_PROVIDER_NAME="Microsoft Entra ID / HSE Healthlink"
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=slainte-clinical-workstation
# OIDC_SCOPES="openid profile email fhirUser"

# Real-time HMAC-signed SIEM incident stream (Microsoft Sentinel, Splunk, PagerDuty):
# SIEM_WEBHOOK_URL=https://sentinel-ingest.hospital.ie/api/webhooks/slainte
